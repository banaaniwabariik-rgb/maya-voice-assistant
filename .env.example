# =====================================================================
# MAYA — SEADISTUSE NÄIDIS
# =====================================================================
# 1. Kopeeri see fail:   cp .env.example .env
# 2. Täida väärtused.
# 3. ÄRA KUNAGI lisa .env faili versioonihaldusesse – see on
#    .gitignore'is ja peab seal püsima.
#
# Siin failis EI OLE ÜHTEGI PÄRIS VÕTIT – ainult kohahoidjad.

# ---------------------------------------------------------------------
# KOHUSTUSLIK: Gemini Live (hääl)
# ---------------------------------------------------------------------
# Hangi võti: https://aistudio.google.com/apikey
# Ilma selleta häälkõne EI TÖÖTA. Vt docs/GEMINI_LIVE.md.
GEMINI_API_KEY=pane_siia_oma_gemini_voti

# ---------------------------------------------------------------------
# VALIKULINE: tekstivestlus ja kõnetuvastus (Groq / Whisper)
# ---------------------------------------------------------------------
# Ilma selleta töötab hääl, aga tekstirada ja Whisperi transkriptsioon
# lülituvad välja (server ütleb selle käivitamisel logis välja).
GROQ_API_KEY=

# ---------------------------------------------------------------------
# VALIKULINE: veebiotsing
# ---------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------
# VALIKULINE: e-posti lugemine (Gmail IMAP)
# ---------------------------------------------------------------------
# Kasuta Google'i RAKENDUSE PAROOLI, mitte oma tavaparooli:
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Teine postkast (valikuline)
GMAIL_USER_2=
GMAIL_APP_PASSWORD_2=

# =====================================================================
# AUTENTIMINE JA TURVALISUS
# =====================================================================
# Kõik /api otspunktid, SSE-vool ja Gemini Live WebSocket nõuavad
# kehtivat tokenit. Esimene registreeruv konto saab admin-õigused.
# Täielik ülevaade: docs/TURVALISUS.md

# Tokeni eluiga sekundites. Vaikimisi 30 päeva.
# MAYA_TOKEN_TTL_S=2592000

# Kas uued kasutajad tohivad end ise registreerida?
# 0 = suletud. ESIMESE konto saab alati luua, muidu ei saaks
# paigaldust kasutusele võtta.
MAYA_ALLOW_REGISTRATION=1

# Kui seatud, nõutakse registreerimisel seda kutsekoodi.
# Pane siia pikk juhuslik sõna, kui server on avalikus võrgus.
# MAYA_INVITE_CODE=

# Kiiruspiirangud (päringut minutis).
# MAYA_RATE_LIMIT=120
# MAYA_LOGIN_RATE_LIMIT=20

# CORS: komaga eraldatud lubatud lähtekohad. TÜHI = CORS keelatud.
# Androidi rakendus EI VAJA seda. Täida ainult siis, kui avad MAYA
# brauserist mingilt muult domeenilt.
# MAYA_CORS_ORIGINS=https://minu-domeen.ee

# =====================================================================
# MAYA ENDA SEADED (kõigil on mõistlik vaikeväärtus)
# =====================================================================

# Projekti juurkaust. Vaikimisi see kaust, kus server/config.py asub.
# MAYA_HOME=/opt/maya

# Andmekaust (andmebaas, allalaaditud failid). Vaikimisi <juur>/data.
# MAYA_DATA_DIR=/var/lib/maya

# Andmebaasi fail. Vaikimisi <andmekaust>/reminders.db
# MAYA_DB_PATH=/var/lib/maya/reminders.db

# Kust server kuulab.
MAYA_HOST=0.0.0.0
MAYA_PORT=8000

# Aadress, mille kaudu server iseendale viitab (dokumentatsioon ja
# logid). NB: Androidi rakendus EI LOE seda – kasutaja sisestab serveri
# aadressi telefonis rakenduse seadistusekraanil.
# MAYA_PUBLIC_URL=http://100.64.0.5:8000

# Nimi, millega karakterid sind kõnetavad (kohahoidja {USER}).
MAYA_USER_NAME=Kasutaja

# Ajavöönd meeldetuletuste ja kellaaja jaoks.
MAYA_TIMEZONE=Europe/Tallinn

# Asukoht ilmainfo ja kohaliku konteksti jaoks. Vaikimisi Tallinn.
MAYA_LOCATION=Tallinn
MAYA_LAT=59.437
MAYA_LON=24.754

# Mis kell sa magad – Maya ei helista sel ajal omal algatusel.
MAYA_SLEEP_START_HOUR=23
MAYA_SLEEP_END_HOUR=8

# Kontaktaadress, mida muusikaandmebaaside API-d nõuavad User-Agent
# päises. Pane siia OMA aadress, kui kasutad laulufunktsiooni.
MAYA_CONTACT_EMAIL=maya@example.org

# ---------------------------------------------------------------------
# VALIKULINE: kohalik kõnesüntees (Piper) varuteena
# ---------------------------------------------------------------------
# MAYA_PIPER_PYTHON=/opt/piper-venv/bin/python
# MAYA_PIPER_HELPER=/opt/maya/piper_helper.py
